<Page
    x:Class="Ak870Pro.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="主页" FontSize="28" FontWeight="SemiBold"/>

            <!-- 连接 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="设备连接" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectBtn" Content="重新扫描连接" Click="Connect_Click" Style="{ThemeResource AccentButtonStyle}"/>
                        <Button x:Name="DisconnectBtn" Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="InfoText" Text="与官方驱动一致：程序启动及设备插入/拔出时自动扫描并握手，无需选择连接模式（USB/2.4G 由接口路径自动判定）。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 层选择 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="配置层 (04 13)" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Layer1Btn" Content="层 1" Click="Layer_Click" Tag="1"/>
                        <Button x:Name="Layer2Btn" Content="层 2" Click="Layer_Click" Tag="2"/>
                        <Button x:Name="Layer3Btn" Content="层 3" Click="Layer_Click" Tag="3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 功能设置 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="功能设置 (0x00 数据包)" FontSize="16" FontWeight="SemiBold"/>
                    <CheckBox x:Name="FnAltF4" Content="禁用 ALT + F4"/>
                    <CheckBox x:Name="FnAltTab" Content="禁用 ALT + TAB"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="fn_switch:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="FnSwitch" Value="0" Minimum="0" Maximum="255" SpinButtonPlacementMode="Compact" Width="120"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="键盘休眠:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SleepCombo" SelectedIndex="0" Width="140">
                            <ComboBoxItem Content="不休眠"/>
                            <ComboBoxItem Content="1 分钟"/>
                            <ComboBoxItem Content="5 分钟"/>
                            <ComboBoxItem Content="30 分钟"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="按键响应:" VerticalAlignment="Center"/>
                        <Slider x:Name="RespondSlider" Minimum="1" Maximum="5" Value="3" Width="200"/>
                        <TextBlock x:Name="RespondText" Text="3 档" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="ApplySettingsBtn" Content="应用设置" Click="ApplySettings_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                    <TextBlock Text="注: 有线约2-3ms/2.4G约5-6ms/蓝牙约12-13ms(一档)，延迟过低可能引起连击。"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
