<Page
    x:Class="Ak870Pro.Views.LightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="灯光" FontSize="28" FontWeight="SemiBold"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="灯效模式:" VerticalAlignment="Center" Width="80"/>
                        <ComboBox x:Name="ModeCombo" Width="220"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="灯光亮度:" VerticalAlignment="Center" Width="80"/>
                        <Slider x:Name="BrightSlider" Minimum="0" Maximum="5" Value="5" Width="220"/>
                        <TextBlock x:Name="BrightText" Text="5" VerticalAlignment="Center" Width="20"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="灯光速度:" VerticalAlignment="Center" Width="80"/>
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="5" Value="3" Width="220"/>
                        <TextBlock x:Name="SpeedText" Text="3" VerticalAlignment="Center" Width="20"/>
                    </StackPanel>
                    <Button x:Name="ApplyBtn" Content="应用" Click="Apply_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 音乐律动: PC 端 ~33ms 持续向键盘推送频谱数据流 (官方 0x433A00 机制) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="音乐律动" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="显示模式:" VerticalAlignment="Center" Width="120"/>
                        <ComboBox x:Name="MusicCombo" Width="220"/>
                    </StackPanel>
                    <StackPanel x:Name="AmpRow" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="振幅:" VerticalAlignment="Center" Width="120"/>
                        <Slider x:Name="AmpSlider" Minimum="0" Maximum="100" Value="60" Width="220"/>
                        <TextBlock x:Name="AmpText" Text="60%" VerticalAlignment="Center" Width="40"/>
                    </StackPanel>
                    <StackPanel x:Name="BgModeRow" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="背景灯光显示模式:" VerticalAlignment="Center" Width="120"/>
                        <ComboBox x:Name="MusicBgCombo" Width="220"/>
                    </StackPanel>
                    <StackPanel x:Name="BgBrightRow" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="背景亮度:" VerticalAlignment="Center" Width="120"/>
                        <Slider x:Name="BgBrightSlider" Minimum="0" Maximum="100" Value="100" Width="220"/>
                        <TextBlock x:Name="BgBrightText" Text="100%" VerticalAlignment="Center" Width="40"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MusicBtn" Content="开启律动" Click="Music_Click" Style="{ThemeResource AccentButtonStyle}"/>
                        <Button x:Name="MusicStopBtn" Content="停止律动" Click="MusicStop_Click"/>
                    </StackPanel>
                    <TextBlock Text="PC 端实时采集系统音频并持续向键盘推送频谱数据流；屏光联动仅 USB 连接可用，选中后振幅与背景设置不生效。"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
